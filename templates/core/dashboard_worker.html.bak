{% extends 'base.html' %}
{% block title %}Worker Portal | CIVYANTRA{% endblock %}
{% block page_heading %}Worker Daily Tasks & Progress Submission{% endblock %}
{% block content %}

<div class="row g-3 mb-3">
  <div class="col-12 col-sm-6 col-lg-3">
    <div class="card border-0 shadow-sm rounded-4 p-3 h-100 border-start border-4 border-primary">
      <small class="text-muted fw-semibold text-uppercase">My Active Sites</small>
      <h3 id="wrk-sites" class="fw-bold mb-0 mt-1">{{ assignments|length }}</h3>
    </div>
  </div>
  <div class="col-12 col-sm-6 col-lg-3">
    <div class="card border-0 shadow-sm rounded-4 p-3 h-100 border-start border-4 border-info">
      <small class="text-muted fw-semibold text-uppercase">Tasks Received</small>
      <h3 id="wrk-total-tasks" class="fw-bold mb-0 mt-1">{{ total_tasks }}</h3>
    </div>
  </div>
  <div class="col-12 col-sm-6 col-lg-3">
    <div class="card border-0 shadow-sm rounded-4 p-3 h-100 border-start border-4 border-warning">
      <small class="text-muted fw-semibold text-uppercase">Work Remaining</small>
      <h3 id="wrk-pending" class="fw-bold mb-0 mt-1 text-warning">{{ pending_count }}</h3>
    </div>
  </div>
  <div class="col-12 col-sm-6 col-lg-3">
    <div class="card border-0 shadow-sm rounded-4 p-3 h-100 border-start border-4 border-success">
      <small class="text-muted fw-semibold text-uppercase">Completed Tasks</small>
      <h3 id="wrk-completed" class="fw-bold mb-0 mt-1 text-success">{{ completed_count }}</h3>
    </div>
  </div>
</div>

<div class="row g-3 mb-4">
  <div class="col-md-6">
    <div class="card border-0 shadow-sm rounded-4 p-3 h-100 border-start border-4 border-success d-flex flex-row justify-content-between align-items-center">
      <div>
        <small class="text-muted fw-semibold text-uppercase d-block">Today's Site Attendance</small>
        {% if today_attendance %}
          <span class="fw-bold text-dark">Checked in at {{ today_attendance.check_in_time|time:"h:i A" }} ({{ today_attendance.project.project_code }})</span>
        {% else %}
          <span class="text-muted">Not checked in yet today</span>
        {% endif %}
      </div>
      <span id="wrk-attendance-badge" class="badge {% if today_attendance %}bg-success{% else %}bg-secondary{% endif %} px-3 py-2">
        {% if today_attendance %}Present Today{% else %}Pending Check-In{% endif %}
      </span>
    </div>
  </div>
  <div class="col-md-6">
    <div class="card border-0 shadow-sm rounded-4 p-3 h-100 border-start border-4 border-danger d-flex flex-row justify-content-between align-items-center">
      <div>
        <small class="text-muted fw-semibold text-uppercase d-block">My Open Site Issues</small>
        <span class="fw-bold text-dark">{{ my_open_problems_count }} Active Report{{ my_open_problems_count|pluralize }}</span>
      </div>
      <span class="badge bg-warning text-dark px-3 py-2">Live Sync Active</span>
    </div>
  </div>
</div>

<div class="card border-0 shadow-sm rounded-4 mb-4">
  <div class="card-header bg-dark text-white rounded-top-4 py-3 px-4 d-flex justify-content-between align-items-center">
    <h6 class="mb-0 fw-bold"><i class="bi bi-list-check me-2 text-warning"></i>Work Given by My Supervisor (Tasks To Do)</h6>
    {% if task_cards %}
      <a href="{% url 'projects:submit_progress' task_cards.0.task.id %}" class="btn btn-warning btn-sm fw-bold">
        <i class="bi bi-check2-square me-1"></i>Submit Work Now
      </a>
    {% else %}
      <a href="{% url 'projects:task_list' %}" class="btn btn-warning btn-sm fw-bold">
        <i class="bi bi-list-check me-1"></i>Open My Tasks
      </a>
    {% endif %}
  </div>
  <div class="card-body p-4">
    {% if task_cards %}
    <div class="table-responsive">
      <table class="table align-middle mb-0">
        <thead class="table-light">
          <tr>
            <th>Task Details</th>
            <th>Allocated By</th>
            <th>Work Progress</th>
            <th style="width: 18%;">Completion</th>
            <th>Deadline & Priority</th>
            <th>Status</th>
            <th class="text-end">Send Work to Supervisor</th>
          </tr>
        </thead>
        <tbody>
          {% for item in task_cards %}
          <tr>
            <td>
              <a href="{% url 'projects:task_detail' item.task.id %}" class="fw-bold text-decoration-none">{{ item.task.title }}</a>
              <small class="text-muted d-block">{{ item.task.project.project_code }} - {{ item.task.project.name }}</small>
            </td>
            <td>
              <span class="fw-semibold">{{ item.task.assigned_by.get_display_name }}</span>
              <small class="text-muted d-block">Supervisor</small>
            </td>
            <td>
              <div class="fw-semibold">{{ item.task.cached_approved_quantity }} / {{ item.task.assigned_quantity }} {{ item.task.unit }}</div>
              <small class="text-muted">Remaining: {{ item.task.remaining_quantity }} {{ item.task.unit }}</small>
            </td>
            <td>
              <div class="d-flex align-items-center gap-2">
                <div class="progress flex-grow-1" style="height: 8px;">
                  <div class="progress-bar bg-success" style="width: {{ item.pct }}%;"></div>
                </div>
                <small class="fw-bold">{{ item.pct }}%</small>
              </div>
            </td>
            <td>
              <div>{{ item.task.deadline }}</div>
              <span class="badge bg-light text-dark border">{{ item.task.get_priority_display }}</span>
            </td>
            <td>
              <span class="badge {% if item.task.status == 'COMPLETED' %}bg-success{% elif item.task.status == 'DELAYED' %}bg-danger{% elif item.task.status == 'IN_PROGRESS' %}bg-warning text-dark{% else %}bg-secondary{% endif %}">
                {{ item.task.get_status_display }}
              </span>
            </td>
            <td class="text-end">
              {% if item.task.status != 'COMPLETED' %}
                <a href="{% url 'projects:submit_progress' item.task.id %}" class="btn btn-success btn-sm fw-bold px-3">
                  <i class="bi bi-check-circle-fill me-1"></i>Submit / Mark Done
                </a>
                <a href="{% url 'projects:report_delay' item.task.id %}" class="btn btn-outline-danger btn-sm mt-1 mt-xl-0">
                  Delay
                </a>
              {% else %}
                <span class="badge bg-success-subtle text-success border border-success px-3 py-2">Approved Done</span>
              {% endif %}
            </td>
          </tr>
          {% endfor %}
        </tbody>
      </table>
    </div>
    {% else %}
      <p class="text-muted mb-0">No tasks have been allocated to you by your supervisor yet.</p>
    {% endif %}
  </div>
</div>

<div class="card border-0 shadow-sm rounded-4 mb-4">
  <div class="card-header bg-white py-3 px-4 border-bottom d-flex justify-content-between align-items-center">
    <h6 class="mb-0 fw-bold"><i class="bi bi-clock-history me-2 text-primary"></i>My Work Submissions Sent to Supervisor</h6>
    <span class="text-muted small">Supervisor Verification Status</span>
  </div>
  <div class="card-body p-4">
    {% if recent_submissions %}
    <div class="table-responsive">
      <table class="table align-middle mb-0">
        <thead class="table-light">
          <tr>
            <th>Task</th>
            <th>Work Date</th>
            <th>Quantity Sent</th>
            <th>Approval Status</th>
            <th>Supervisor Notes</th>
          </tr>
        </thead>
        <tbody>
          {% for sub in recent_submissions %}
          <tr>
            <td>
              <div class="fw-semibold">{{ sub.task.title }}</div>
              <small class="text-muted">{{ sub.task.project.project_code }}</small>
            </td>
            <td>{{ sub.work_date }}</td>
            <td class="fw-semibold">{{ sub.quantity_submitted }} {{ sub.task.unit }}</td>
            <td>
              <span class="badge {% if sub.status == 'APPROVED' %}bg-success{% elif sub.status == 'REJECTED' %}bg-danger{% else %}bg-warning text-dark{% endif %}">
                {{ sub.get_status_display }}
              </span>
            </td>
            <td><small class="text-muted">{{ sub.review_notes|default:"Waiting for supervisor review" }}</small></td>
          </tr>
          {% endfor %}
        </tbody>
      </table>
    </div>
    {% else %}
      <p class="text-muted mb-0">You have not submitted any task progress yet. Click "Submit Work" on a task above when you complete work.</p>
    {% endif %}
  </div>
</div>

<div class="card border-0 shadow-sm rounded-4">
  <div class="card-header bg-white py-3 px-4 border-bottom">
    <h6 class="mb-0 fw-bold"><i class="bi bi-building me-2 text-success"></i>My Assigned Construction Sites ({{ assignments|length }})</h6>
  </div>
  <div class="card-body p-4">
    <div class="list-group">
      {% for a in assignments %}
        <a href="{% url 'projects:project_detail' a.project.id %}" class="list-group-item list-group-item-action d-flex justify-content-between align-items-center">
          <div>
            <strong>{{ a.project.project_code }}</strong> - {{ a.project.name }}
            <small class="text-muted d-block">Supervisor: {{ a.project.supervisor.get_display_name }} | Assigned: {{ a.assigned_date }}</small>
          </div>
          <span class="badge bg-success">Active Site</span>
        </a>
      {% empty %}
        <p class="text-muted mb-0">You are not currently assigned to any active construction site.</p>
      {% endfor %}
    </div>
  </div>
</div>

<script>
  setInterval(function () {
    fetch("{% url 'core:dashboard_live_stats' %}")
      .then(function (res) { return res.ok ? res.json() : null; })
      .then(function (data) {
        if (!data || data.role !== 'WORKER') return;
        const setTxt = function (id, val) {
          const el = document.getElementById(id);
          if (el && val !== undefined) el.textContent = val;
        };
        setTxt('wrk-sites', data.site_count);
        setTxt('wrk-total-tasks', data.total_tasks);
        setTxt('wrk-pending', data.pending_count);
        setTxt('wrk-completed', data.completed_count);
        const badge = document.getElementById('wrk-attendance-badge');
        if (badge && data.checked_in_today !== undefined) {
          badge.textContent = data.checked_in_today ? 'Present Today' : 'Pending Check-In';
          badge.className = data.checked_in_today ? 'badge bg-success px-3 py-2' : 'badge bg-secondary px-3 py-2';
        }
      })
      .catch(function () {});
  }, 10000);
</script>
{% endblock %}
